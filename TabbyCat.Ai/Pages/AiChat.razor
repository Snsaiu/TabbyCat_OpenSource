@page "/ai-chat"

@inherits TabbyCat.Ai.Bases.AiPageComponentBase
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using Microsoft.FluentUI.AspNetCore.Components
@using TabbyCat.Ai.Components
<div style="width:100%;overflow: hidden" id="chatContainer">
    <FluentHeader Style="position: fixed;top: 0;" Id="chat-header">
        <FluentSpacer></FluentSpacer>
        AI Chat
        <FluentSpacer></FluentSpacer>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right" style="position:fixed;top:10px;right:5px;">
            <FluentButton OnClick="NewChatSessionCommand" IconStart="@(new Size20.ChatAdd())"></FluentButton>
            <FluentButton OnClick="ShowAiChatMenuCommand" IconStart="@(new Size20.ChatSettings())"></FluentButton>
        </FluentStack>

    </FluentHeader>
    <div Style="margin-bottom:50px; margin-top: 50px; ">
        <ChatMessageList Messages="@ChatModels" IsLoading="IsBusy"></ChatMessageList>
    </div>

    <ChatInput OnSend="SendCommand"></ChatInput>

</div>