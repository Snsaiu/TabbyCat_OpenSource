@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using TabbyCat.Shared.Enums
@using Microsoft.FluentUI.AspNetCore.Components
@inherits TabbyCat.Ai.Bases.AiComponentBase
<div id="messagesContainer" style="overflow-y:scroll; overflow-x: hidden;">
    @foreach (var message in Messages)
    {
        @if (message.Role == Role.User)
        {
            <FluentCard Style="height: auto">
                <FluentStack>
                    <div>
                        <FluentIcon Value="@(new Size24.PersonChat())"/>
                    </div>

                    <div>
                        <span>@message.Content</span>
                    </div>
                </FluentStack>

            </FluentCard>
        }
        else if (message.Role == Role.Assistant)
        {
            <FluentCard Style="height:auto">
                <FluentStack>
                    <div style="position:relative;">
                        <FluentIcon Value="@(new Size24.LightbulbPerson())"/>
                    </div>

                    <div>
                        <ModelMarkdown Message="@message.Content"></ModelMarkdown>
                    </div>
                </FluentStack>

            </FluentCard>
        }
    }
    @if (IsLoading)
    {
        <FluentCard Style="height: auto;">
            <FluentStack>
                <div style="position:relative;">
                    <FluentIcon Value="@(new Size24.LightbulbPerson())"/>

                    <FluentProgressRing
                        Style="height:24px; width:24px; position:absolute; top:0px; left:0px;"></FluentProgressRing>
                </div>

            </FluentStack>

        </FluentCard>
     
    }
   

</div>