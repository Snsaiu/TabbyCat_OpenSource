
@implements  Microsoft.FluentUI.AspNetCore.Components.IDialogContentComponent<string>
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inherits TabbyCat.VisualBase.Bases.VisualPageBase

<!-- Body -->
<FluentDialogBody>
    <EditForm EditContext="@_editContext" FormName="simple_register">
        <DataAnnotationsValidator/>
        <FluentTextField Style="width: 100%" Name="register_name"
                         @bind-Value="@Content"
                         Label="重命名"
                         Placeholder="请输入新名称"
                         Required/>
        <div style="color: red;">
            <FluentValidationSummary/>
        </div>
    </EditForm>
</FluentDialogBody>

<!-- Footer -->
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent"
                  Disabled="@(!_editContext.Validate())"
                  OnClick="@SaveAsync">
        Save
    </FluentButton>
    <FluentButton Appearance="Appearance.Neutral"
                  OnClick="@CancelAsync">
        Cancel
    </FluentButton>
</FluentDialogFooter>