@using Microsoft.FluentUI.AspNetCore.Components
@inherits TabbyCat.Ai.Bases.AiComponentBase

<div style="width:100%">

    @{
      
        if (DeviceInfo.Current.Idiom == DeviceIdiom.Desktop || DeviceInfo.Current.Idiom == DeviceIdiom.Tablet)
        {
            bottomStyle = "bottom:0px;";
        }
        else
        {
            bottomStyle = "bottom:45px;";
        }
    }
    <div class="bottom-div" style="@bottomStyle" id="bottom-div">
  <FluentStack Orientation="Orientation.Horizontal"HorizontalGap="0">

 
      <FluentTextArea Required="true" Autofocus="true" Style="width:100%" Value="@text"  Id="textarea"></FluentTextArea>
      <FluentButton  OnClick="SendCommand"
          Id="sendBtn"
                    IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Send())"></FluentButton>
    </FluentStack>

</div>
</div>