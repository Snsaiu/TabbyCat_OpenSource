@layout EmptyLayout

@page "/"
@using TabbyCat.App.Components.Layout
@inherits TabbyCat.VisualBase.Bases.PageComponentBase

<div>
    <div style="text-align: center;">
        <img src="images/logo_with_text.png" style="margin-top: 20%; width: 50%;"/>
    </div>

    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center"
                 Style="margin-top: 20px;">
        <FluentLabel Alignment="HorizontalAlignment.Left">@Localizer["NickOfName"]</FluentLabel>
        <FluentTextField TextFieldType="TextFieldType.Text" @bind-Value="@UserName"></FluentTextField>
        <FluentLabel Alignment="HorizontalAlignment.Left">@($"{Localizer["DeviceNickname"]}:")</FluentLabel>
        <FluentTextField TextFieldType="TextFieldType.Text"
                         @bind-Value="@DeviceNiceName"></FluentTextField>
        <FluentButton OnClick="LoginAsync">@Localizer["Login"]</FluentButton>
        <FluentProgressRing Visible="@IsBusy"></FluentProgressRing>
    </FluentStack>

</div>