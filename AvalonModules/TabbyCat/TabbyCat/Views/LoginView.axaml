<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TabbyCat.ViewModels"
             xmlns:attachs="clr-namespace:TuDog.Attachs;assembly=TuDog"
             xmlns:tabbyCat="clr-namespace:TabbyCat"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TabbyCat.Views.LoginView"

             x:DataType="viewModels:LoginViewModel">

    <Grid RowDefinitions="*,Auto,Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Height="300" Width="300" Source="../Assets/logo.png">

        </Image>

        <TextBox Watermark="用户昵称" Margin="5" Grid.Row="1" />
        <TextBox Watermark="设备昵称" Margin="5" Grid.Row="2" />
        <Button Content="Login" HorizontalAlignment="Center" Command="{Binding LoginCommand}" Grid.Row="3" />
    </Grid>
</UserControl>