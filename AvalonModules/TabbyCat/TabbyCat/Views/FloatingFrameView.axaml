<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TabbyCat.ViewModels"
             xmlns:controls="clr-namespace:TabbyCat.Controls"
             xmlns:extensions="clr-namespace:TabbyCat.Extensions"
             xmlns:tabbyCat="clr-namespace:TabbyCat"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:FloatingFrameViewModel"
             Loaded="Control_OnLoaded"
             x:Class="TabbyCat.Views.FloatingFrameView">

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button HorizontalAlignment="Left" Name="toggle"
                    IsHitTestVisible="True">
                <Image Source="/Assets/cat.png" Height="30" />
            </Button>
            <TextBox VerticalContentAlignment="Center" VerticalAlignment="Center" Width="300"
                     Text="{Binding InputTextContent}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                </TextBox.KeyBindings>
                <TextBox.Styles>
                    <Style Selector="TextBox">
                        <Setter Property="InnerRightContent">
                            <Setter.Value>
                                <Template>
                                    <Button Classes="icon"
                                            Command="{Binding ClearInputCommand}"
                                            extensions:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.shanchu1}"
                                            IsVisible="{Binding InputTextContent.Length}" />
                                </Template>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Styles>
            </TextBox>
            <Button IsVisible="{OnPlatform Windows=true,Default=false}"
                    Classes="icon"
                    Command="{Binding ShowOutPutPanelCommand}"
                    extensions:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.Eye}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowOutputPanel}" Background="{StaticResource SolidBackgroundFillColorBase}"
                    Name="contentPanel" Width="400">
            <ScrollViewer Name="sv" MaxHeight="300">
                <controls:ChatItem Message="{Binding AiResponseMessageItem}" />
            </ScrollViewer>
        </StackPanel>
    </StackPanel>
</UserControl>