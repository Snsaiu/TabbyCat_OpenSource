<windowing:AppWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:vm="using:TabbyCat.ViewModels"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                     x:Class="TabbyCat.Views.MainWindow"
                     xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
                     xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
                     xmlns:attachs="clr-namespace:TuDog.Attachs;assembly=TuDog"
                     xmlns:viewModels="clr-namespace:TabbyCat.ViewModels"
                     xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                     xmlns:extensions="clr-namespace:TabbyCat.Extensions"
                     xmlns:tabbyCat="clr-namespace:TabbyCat"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:languages="clr-namespace:TabbyCat.Shared.Languages;assembly=TabbyCat.Shared"
                     ExtendClientAreaChromeHints="NoChrome"
                     ExtendClientAreaToDecorationsHint="True"
                     x:DataType="viewModels:MainWindowViewModel">
    <Window.DataContext>
        <vm:MainWindowViewModel></vm:MainWindowViewModel>
    </Window.DataContext>
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Padding="0,5">
            <Grid>
                <!-- 左上角的按钮组 -->
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{OnPlatform Default=false, macOS=true}" >
                    <StackPanel.Styles>
                        <Style Selector="StackPanel:pointerover Button.MacosTitleBarButton /template/ Border controls|FontIcon#Icon">
                           <Setter Property="Foreground" Value="Black"></Setter>
                        </Style>
                    </StackPanel.Styles>
                    <Button Classes="MacosTitleBarButton" Click="OnClose" extensions:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.MacosClose}"  Foreground="#FF605C" Background="#FF605C" />
                    <Button Classes="MacosTitleBarButton" Click="OnMin" extensions:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.MacosMinimize}" Background="#FFBD44" Foreground="#FFBD44"  Margin="6,0,0,0" />
                    <!-- <Button Classes="MacosTitleBarButton" extensions:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.MacosMaximize}" Background="#00CA4E" Foreground="#00CA4E" Margin="6,0,0,0" /> -->
                </StackPanel>

                <!-- 标题文本 -->
                <TextBlock Text="{x:Static languages:AppResources.TabbyCat}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
        <Image Source="/Assets/screen.png" Stretch="UniformToFill" Opacity="0.5" >
            <Image.Styles>
                <Style Selector="Image">
                    <Style.Animations>
                        <Animation Duration="00:00:05">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="30%">
                                <Setter Property="Opacity" Value="1"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="60%">
                                <Setter Property="Opacity" Value="1"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="0.5"></Setter>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Image.Styles>
        </Image>
        <ContentControl attachs:RegionBehavior.Region="mainContainer">
            <ContentControl.Styles>
                <Style Selector="ContentControl">
                    <Style.Animations>
                        <Animation Duration="00:00:08">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="60%">
                                <Setter Property="Opacity" Value="1"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"></Setter>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </ContentControl.Styles>
        </ContentControl>

    </Grid>
    </Grid>
    <i:Interaction.Behaviors>
        <ia:EventTriggerBehavior EventName="Loaded" >
            <ia:InvokeCommandAction Command="{Binding LoadedCommand}"></ia:InvokeCommandAction>
        </ia:EventTriggerBehavior>
    </i:Interaction.Behaviors>
</windowing:AppWindow>