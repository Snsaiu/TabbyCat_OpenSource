<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:TabbyCat.ViewModels"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:runningHubEntities="clr-namespace:TabbyCat.Repository.Entities.RunningHubEntities;assembly=TabbyCat.Repository"
        xmlns:extensions="clr-namespace:TuDog.Extensions;assembly=TuDog"
        xmlns:extensions1="clr-namespace:TabbyCat.Extensions"
        xmlns:tabbyCat="clr-namespace:TabbyCat"
        xmlns:languages="clr-namespace:TabbyCat.Shared.Languages;assembly=TabbyCat.Shared">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

   <Style Selector=":is(UserControl).AiMediaStyle">
       <Setter Property="Template">
           <Setter.Value>
               <ControlTemplate TargetType="UserControl">
                   <Grid RowDefinitions="Auto,*,Auto" Name="mainGrid">
                       <StackPanel Orientation="Vertical">
                           <ProgressBar IsIndeterminate="True" IsVisible="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).IsBackgroundTaskRunning}"></ProgressBar>
                           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                               <controls:FontIcon ToolTip.Tip="{x:Static languages:AppResources.RunningTaskCount}" Classes="icon"
                                                  Glyph="{x:Static tabbyCat:IconFontProvider.DoingTask}"
                                                  VerticalAlignment="Center" />
                               <TextBlock
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).WorkingTaskCount}" />
                               <Button ToolTip.Tip="{x:Static languages:AppResources.Portfolio}"
                                       Classes="icon"
                                       extensions1:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.Portfolio}"
                                       Command="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).OpenPortfolioCommand}"
                                       HorizontalAlignment="Right" />
                           </StackPanel>
                       </StackPanel>


                       <Grid Grid.Row="1" ColumnDefinitions="*,*">
                           <ContentPresenter Content="{TemplateBinding Content}" />
                           <ScrollViewer  Grid.Column="1">
                           <ItemsControl

                               ItemsSource="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).LastBuildResultImages}">
                               <ItemsControl.ItemTemplate>
                                   <DataTemplate>
                                       <Image Source="{Binding . , Converter={extensions:ImageConverter}}" Width="200"
                                              Height="200" />
                                   </DataTemplate>
                               </ItemsControl.ItemTemplate>
                               <ItemsControl.ItemsPanel>
                                   <ItemsPanelTemplate>
                                       <WrapPanel ItemHeight="200" ItemWidth="200" />
                                   </ItemsPanelTemplate>
                               </ItemsControl.ItemsPanel>
                           </ItemsControl>
                           </ScrollViewer>
                       </Grid>

                       <Button Width="100" Grid.Row="2" Content="{x:Static languages:AppResources.Perform}"
                               IsEnabled="{Binding !$parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).IsBackgroundTaskRunning}"
                               Command="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).ConfirmCommand}" HorizontalAlignment="Left" Margin="{StaticResource Margin10}" />
                       <controls:PickerFlyoutPresenter
                           Grid.Row="0"
                           Grid.RowSpan="3"
                           Width="300"
                           Height="{Binding ElementName=mainGrid, Path=Height}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           IsVisible="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).ShowPanel}">
                      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                           <ListBox
                               ItemsSource="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).Results}">
                               <ListBox.ItemTemplate>
                                   <DataTemplate DataType="runningHubEntities:RunningHubResultEntity">
                                       <Grid RowDefinitions="*,Auto">
                                           <Image Source="{Binding SavePath, Converter={extensions:ImageConverter}}"
                                                  Width="80" Height="80"
                                                  Stretch="UniformToFill" />
                                           <Grid Grid.Row="1" ColumnDefinitions="*,*,*"
                                                 HorizontalAlignment="Stretch">
                                               <Button Classes="icon"
                                                       CommandParameter="{Binding .}"
                                                       ToolTip.Tip="{x:Static languages:AppResources.OpenImage}"
                                                       Command="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).OpenImageByDefaultProgramCommand}"
                                                       extensions1:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.Look}" />

                                               <Button Classes="icon" HorizontalAlignment="Center"
                                                       Grid.Column="1"
                                                       ToolTip.Tip="{x:Static languages:AppResources.Download}"
                                                       extensions1:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.Download}"
                                                       CommandParameter="{Binding .}"
                                                       Command="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).SaveFileToLocalCommand}" />

                                               <Button Classes="icon"
                                                       Grid.Column="2"
                                                       ToolTip.Tip="{x:Static languages:AppResources.Delete}"
                                                       Command="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).DeleteMediaCommand}"
                                                       CommandParameter="{Binding .}"
                                                       extensions1:IconAttach.Icon="{x:Static tabbyCat:IconFontProvider.Delete}" />
                                           </Grid>
                                       </Grid>
                                   </DataTemplate>
                               </ListBox.ItemTemplate>
                               <ListBox.ItemsPanel>
                                   <ItemsPanelTemplate>
                                           <WrapPanel Width="300" ItemWidth="100" />
                                   </ItemsPanelTemplate>
                               </ListBox.ItemsPanel>
                           </ListBox>
                      </ScrollViewer>
                           <controls:PickerFlyoutPresenter.Styles>
                               <Style Selector="controls|PickerFlyoutPresenter /template/ Button#DismissButton">
                                   <Setter Property="IsVisible" Value="False" />
                               </Style>
                               <Style Selector="controls|PickerFlyoutPresenter /template/ Button#AcceptButton">
                                   <Setter Property="(Grid.ColumnSpan)" Value="2" />
                               </Style>
                           </controls:PickerFlyoutPresenter.Styles>

                           <Interaction.Behaviors>
                               <EventTriggerBehavior EventName="Confirmed">
                                   <InvokeCommandAction Command="{Binding $parent[UserControl].((viewModels:AiMediaViewModelBase)DataContext).ClosePortfolioPanelCommand}" />
                               </EventTriggerBehavior>
                               <!-- <EventTriggerBehavior EventName="Dismissed"> -->
                               <!--     <InvokeCommandAction Command="{Binding SettingDismissCommand}" /> -->
                               <!-- </EventTriggerBehavior> -->
                           </Interaction.Behaviors>
                       </controls:PickerFlyoutPresenter>
                   </Grid>
               </ControlTemplate>
           </Setter.Value>
       </Setter>
   </Style>
</Styles>